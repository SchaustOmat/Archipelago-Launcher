+// APLauncher: report where Mario is so the launcher HUD can show what is left in this course.
+static void aplauncher_report_location(void) {
+    static s16 lastLevel = -1, lastCourse = -1, lastArea = -1;
+    if (gCurrLevelNum == lastLevel && gCurrCourseNum == lastCourse && gCurrAreaIndex == lastArea) {
+        return;
+    }
+    lastLevel = gCurrLevelNum;
+    lastCourse = gCurrCourseNum;
+    lastArea = gCurrAreaIndex;
+    FILE *f = fopen(fs_get_write_path("aplauncher_location.txt"), "w");
+    if (f) {
+        fprintf(f, "%d %d %d\n", lastLevel, lastCourse, lastArea);
+        fclose(f);
+    }
+}
+
 s32 lvl_init_or_update(s16 initOrUpdate, UNUSED s32 unused) {
     s32 result = 0;
 
@@ -1317,6 +1335,7 @@ s32 lvl_init_or_update(s16 initOrUpdate, UNUSED s32 unused) {
             break;
         case 1:
             result = update_level();
+            aplauncher_report_location();
             break;
     }
 
