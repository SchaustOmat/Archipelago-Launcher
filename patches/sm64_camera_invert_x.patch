     {.name = "skip_intro",           .type = CONFIG_TYPE_BOOL, .boolValue = &configSkipIntro},
+    {.name = "camera_invert_x",      .type = CONFIG_TYPE_BOOL, .boolValue = &configInvertCameraX},
